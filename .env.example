# ============================================================
# COACH MALEK — Frontend environment variables
# Copy to .env.local for local dev. In EasyPanel, add each of
# these under the frontend service's "Environment" tab.
# Only NEXT_PUBLIC_* variables are exposed to the browser bundle.
# Never put secrets/access tokens in NEXT_PUBLIC_* variables.
# ============================================================

# --- Site config ---
NEXT_PUBLIC_SITE_URL=https://awmalek.ch
NEXT_PUBLIC_DEFAULT_LOCALE=fr

# --- Backend API (server-side only, used by the Next.js route
#     handlers in src/app/api/* that proxy to the backend so the
#     backend's internal URL is never exposed to the browser) ---
BACKEND_API_URL=https://api.awmalek.ch
BACKEND_API_INTERNAL_URL=http://backend:4000

# --- Booking ---
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/aouissaouimalek98/30min

# --- WhatsApp floating button ---
NEXT_PUBLIC_WHATSAPP_NUMBER=41766879555
NEXT_PUBLIC_WHATSAPP_DEFAULT_MESSAGE=Bonjour, je souhaite en savoir plus sur le coaching Coach Malek.

# --- Social ---
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/awmalek.coaching

# --- Google Maps (studio location on the contact page) ---
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=REPLACE_ME
NEXT_PUBLIC_STUDIO_ADDRESS="Rue Example 1, 1000 Lausanne, Switzerland"

# --- Public pixel IDs only (no access tokens here — those are
#     backend-only, see backend/.env.example). These IDs are safe
#     to expose in the client bundle; they identify the ad account,
#     not a credential. ---
NEXT_PUBLIC_META_PIXEL_ID=REPLACE_ME
NEXT_PUBLIC_TIKTOK_PIXEL_ID=REPLACE_ME
NEXT_PUBLIC_SNAP_PIXEL_ID=REPLACE_ME

# --- Google Analytics / Search Console (optional but recommended) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=REPLACE_ME
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=REPLACE_ME
